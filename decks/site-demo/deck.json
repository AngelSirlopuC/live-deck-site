{
  "version": 1,
  "title": "Live Deck: site demo",
  "theme": { "preset": "brutalista" },
  "slides": [
    {
      "id": "cover",
      "notes": "Demo deck embedded on the project landing page. Welcome the room and ask everyone to scan the code.",
      "elements": [
        { "id": "star", "type": "decor", "shape": "star", "box": { "x": 0.5, "y": 0.06, "w": 0.1, "h": 0.178 }, "style": { "opacity": 1 } },
        { "id": "title", "type": "text", "box": { "x": 0.07, "y": 0.24, "w": 0.53, "h": 0.4 }, "text": "Slides your audience can answer", "style": { "fontSize": 100, "fontWeight": 800, "font": "display", "lineHeight": 1, "tracking": -0.02 } },
        { "id": "subtitle", "type": "text", "box": { "x": 0.07, "y": 0.7, "w": 0.5, "h": 0.1 }, "text": "Scan the code and follow on your phone.", "style": { "fontSize": 36, "lineHeight": 1.3 } },
        { "id": "qr", "type": "qr", "box": { "x": 0.64, "y": 0.16, "w": 0.29, "h": 0.68 }, "style": { "background": "#ffffff", "color": "#111111" } }
      ]
    },
    {
      "id": "screens",
      "notes": "Press next three times: each screen appears as a fragment. Try focus on the phone column.",
      "elements": [
        { "id": "h", "type": "text", "box": { "x": 0.07, "y": 0.1, "w": 0.86, "h": 0.14 }, "text": "One talk, every screen", "style": { "fontSize": 80, "fontWeight": 800, "font": "display" } },
        { "id": "i1", "type": "icon", "name": "laptop", "box": { "x": 0.16, "y": 0.36, "w": 0.08, "h": 0.142 }, "fragment": 1 },
        { "id": "l1", "type": "text", "box": { "x": 0.07, "y": 0.55, "w": 0.26, "h": 0.2 }, "text": "You drive from the console", "fragment": 1, "style": { "fontSize": 40, "align": "center", "lineHeight": 1.25 } },
        { "id": "i2", "type": "icon", "name": "smartphone", "box": { "x": 0.46, "y": 0.36, "w": 0.08, "h": 0.142 }, "fragment": 2 },
        { "id": "l2", "type": "text", "box": { "x": 0.37, "y": 0.55, "w": 0.26, "h": 0.2 }, "text": "Phones follow live", "fragment": 2, "style": { "fontSize": 40, "align": "center", "lineHeight": 1.25, "mark": true } },
        { "id": "i3", "type": "icon", "name": "refresh-cw", "box": { "x": 0.76, "y": 0.36, "w": 0.08, "h": 0.142 }, "fragment": 3 },
        { "id": "l3", "type": "text", "box": { "x": 0.67, "y": 0.55, "w": 0.26, "h": 0.2 }, "text": "Late? Browse back on your own", "fragment": 3, "style": { "fontSize": 40, "align": "center", "lineHeight": 1.25 } }
      ]
    },
    {
      "id": "quiz-install",
      "layout": "quiz",
      "notes": "Live results: bars move as people vote. Reveal after a few votes.",
      "elements": [],
      "quiz": {
        "question": "What does the audience install to join?",
        "options": ["A mobile app", "A browser extension", "Nothing, they scan the QR"],
        "correctIndex": 2,
        "display": "live"
      }
    },
    {
      "id": "zero",
      "notes": "Land the point: the browser is the client.",
      "elements": [
        { "id": "card", "type": "text", "box": { "x": 0.07, "y": 0.16, "w": 0.5, "h": 0.68 }, "text": "0", "style": { "fontSize": 300, "fontWeight": 800, "font": "display", "align": "center", "valign": "middle", "card": true, "tracking": -0.03 } },
        { "id": "label", "type": "text", "box": { "x": 0.62, "y": 0.16, "w": 0.31, "h": 0.68 }, "text": "apps to install. Phones join from the browser.", "style": { "fontSize": 48, "lineHeight": 1.2, "valign": "middle" } }
      ]
    },
    {
      "id": "closing",
      "notes": "Close: show the install command and end the session.",
      "background": { "color": "#f4f1e8", "pattern": "grid" },
      "elements": [
        { "id": "grid", "type": "decor", "shape": "grid", "box": { "x": 0.78, "y": 0.62, "w": 0.2, "h": 0.36 }, "style": { "opacity": 0.5 } },
        { "id": "turn", "type": "text", "box": { "x": 0.07, "y": 0.26, "w": 0.86, "h": 0.3 }, "text": "Your turn", "style": { "fontSize": 200, "fontWeight": 800, "font": "display", "align": "center", "valign": "middle", "uppercase": true, "mark": true } },
        { "id": "cmd", "type": "text", "box": { "x": 0.12, "y": 0.64, "w": 0.76, "h": 0.1 }, "text": "npx skills add AngelSirlopuC/live-deck", "style": { "fontSize": 40, "font": "mono", "align": "center" } }
      ]
    }
  ]
}
